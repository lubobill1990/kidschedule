{
  "description": "提醒阈值与下次触发时刻计算(协议 §13)。输入:kind(instant|duration)、reminder_mode(auto|fixed)、reminder_fixed_interval_sec、events(按任意序给出,含 started_at/ended_at/status/deleted)。计算规则:排除 deleted 事件,按 started_at 升序取最近 REMINDER_SAMPLE_N=20 个事件为样本;auto 模式要求样本事件数 >= REMINDER_MIN_SAMPLES=5,否则不提醒;间隔 = 样本内相邻事件 started_at 之差(秒);P90 = 间隔升序排列后第 ceil(0.9*n) 个(1-based);fixed 模式阈值 = reminder_fixed_interval_sec(至少需 1 个事件作锚点);锚点 = 最近事件的 started_at(instant)或 ended_at ?? started_at(duration);next_fire_at = 锚点 + 阈值;样本中存在 status=ongoing 的事件则不提醒。expected 中 null 表示不提醒。",
  "cases": [
    {
      "name": "auto_p90_basic_instant",
      "kind": "instant",
      "reminder_mode": "auto",
      "events": [
        { "started_at": "2026-08-21T00:00:00.000Z" },
        { "started_at": "2026-08-21T03:00:00.000Z" },
        { "started_at": "2026-08-21T05:30:00.000Z" },
        { "started_at": "2026-08-21T08:30:00.000Z" },
        { "started_at": "2026-08-21T11:00:00.000Z" },
        { "started_at": "2026-08-21T14:00:00.000Z" }
      ],
      "expected": { "threshold_sec": 10800, "next_fire_at": "2026-08-21T17:00:00.000Z" }
    },
    {
      "name": "auto_insufficient_samples",
      "kind": "instant",
      "reminder_mode": "auto",
      "events": [
        { "started_at": "2026-08-21T00:00:00.000Z" },
        { "started_at": "2026-08-21T03:00:00.000Z" },
        { "started_at": "2026-08-21T06:00:00.000Z" },
        { "started_at": "2026-08-21T09:00:00.000Z" }
      ],
      "expected": { "threshold_sec": null, "next_fire_at": null }
    },
    {
      "name": "fixed_mode_ignores_pattern",
      "kind": "instant",
      "reminder_mode": "fixed",
      "reminder_fixed_interval_sec": 14400,
      "events": [
        { "started_at": "2026-08-21T00:00:00.000Z" },
        { "started_at": "2026-08-21T10:00:00.000Z" }
      ],
      "expected": { "threshold_sec": 14400, "next_fire_at": "2026-08-21T14:00:00.000Z" }
    },
    {
      "name": "fixed_mode_no_events_no_anchor",
      "kind": "instant",
      "reminder_mode": "fixed",
      "reminder_fixed_interval_sec": 14400,
      "events": [],
      "expected": { "threshold_sec": null, "next_fire_at": null }
    },
    {
      "name": "duration_anchor_uses_ended_at",
      "kind": "duration",
      "reminder_mode": "auto",
      "events": [
        { "started_at": "2026-08-21T00:00:00.000Z", "ended_at": "2026-08-21T00:20:00.000Z", "status": "done" },
        { "started_at": "2026-08-21T03:00:00.000Z", "ended_at": "2026-08-21T03:25:00.000Z", "status": "done" },
        { "started_at": "2026-08-21T05:30:00.000Z", "ended_at": "2026-08-21T05:50:00.000Z", "status": "done" },
        { "started_at": "2026-08-21T08:30:00.000Z", "ended_at": "2026-08-21T08:55:00.000Z", "status": "done" },
        { "started_at": "2026-08-21T11:00:00.000Z", "ended_at": "2026-08-21T11:30:00.000Z", "status": "done" },
        { "started_at": "2026-08-21T14:00:00.000Z", "ended_at": "2026-08-21T14:15:00.000Z", "status": "done" }
      ],
      "comment": "间隔仍按 started_at 计算(P90=10800),锚点用最近一次的 ended_at 14:15",
      "expected": { "threshold_sec": 10800, "next_fire_at": "2026-08-21T17:15:00.000Z" }
